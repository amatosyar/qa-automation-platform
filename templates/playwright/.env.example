# URL del ambiente objetivo.
BASE_URL=

# Browser autorizado por el ambiente.
# Ejemplo: chrome
BROWSER_CHANNEL=chrome

# Opcional: ejecutable autorizado específico.
# No hardcodear rutas de una máquina en el código.
BROWSER_EXECUTABLE=

# true / false
HEADLESS=true

# Secretos: solo runtime/local. Nunca versionarlos.
APP_USERNAME=
APP_PASSWORD=
